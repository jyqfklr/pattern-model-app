function genericWeeks(label: string): WeekEntry[] {
  return [
    { theme: '真空宣言与定位', tasks: [`宣言：在「${label}」上当前模型待验证，先诊断再行动`, '写下你对此领域最自信的 3 个假设', '粗粒度定位：找 2–3 个最接近的已知类比'], milestone: '一页《领域地图》：关键要素、已知类比、假设清单' },
    { theme: '环境搭建与最小实验', tasks: ['搭建认知卸载环境：笔记/工具/可请教的他人', '做一次最小实验：小成本接触核心活动并记录结果', '固定每日投入时段，物理隔离干扰'], milestone: '环境就绪 + 首次最小实验的原始记录' },
    { theme: '浸泡启动', tasks: ['每天固定时长的核心动作重复，追求自动化', '把高频动作整理成模板卡 5 张', '每晚原始记录当天卡壳点，不解释'], milestone: '连续 5 天浸泡完成，模板卡 15 张' },
    { theme: '模板化', tasks: ['高频流程全部模板卡化，累计 30 张', '每天开始前过一遍昨日模板卡', '同类动作连做 5 次，直到不依赖模板'], milestone: '核心流程自动化，不再刻意思考步骤' },
    { theme: '双缓冲流水线', tasks: ['每个工作块最后 10 分钟预载下一周期内容', '今晚写明明天的第一个动作，交给睡眠孵化', '统计时间块完成率，低于 70% 砍目标'], milestone: '流水线连续运转 7 天' },
    { theme: '半程全真暴露', tasks: ['做一次全真检验（测试/交付/实战）', '逐条记录误差并分类', '误差 24 小时内只看不动，禁止抹平'], milestone: '《半程误差报告》' },
    { theme: '误差批处理', tasks: ['误差按频率排序，找出前 3 大薄弱点', '每个薄弱点配一个变式练习/对照实验', '写下 3 条"我原以为…实际上是…"'], milestone: '薄弱点 Top3 各有整改方案' },
    { theme: '飞轮加速', tasks: ['每天写下 1 个可证伪预测并当天检验', '被违反的高置信预测标记为"高价值"', '高价值误差持有 48 小时后再整合'], milestone: '5 次预测闭环，至少 1 个高价值误差' },
    { theme: '变式训练', tasks: ['把已会的内容换 3 种条件重做', '混合打乱顺序练习，打破顺序依赖', '给每个失误写"下次识别特征"'], milestone: '混合检验正确率 80% 以上' },
    { theme: '弱项攻坚', tasks: ['80% 时间押在最弱的 20% 内容上', '用"教别人"的方式重学弱项', '每天只记录弱项进展'], milestone: '最弱模块自测达到及格线' },
    { theme: '输出倒逼', tasks: ['把所学所练写成教程/讲稿/作品', '找真实对象展示 20 分钟，记录讲不清处', '按反馈回补 3 个漏洞'], milestone: '一次完整对外输出' },
    { theme: '整合与升级', tasks: ['验证有效的模式写入长期记忆系统', '身份模块升级到 v0.2，写下差异', '制定下一周期计划：留有效结构，换失效预测单元'], milestone: '《本周期模式清单》+ 下周期计划草案' },
  ];
}
