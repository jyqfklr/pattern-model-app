const RELATIONSHIP_WEEKS: WeekEntry[] = [
  { theme: '真空宣言与假设清点', tasks: ['宣言：我对这段关系的"理解"待验证，先从观察开始', '写下你对对方"最自信"的 3 个判断（ta 喜欢什么/在意什么/怎么想我）', '标注：这 3 个判断最后一次被验证是什么时候？'], milestone: '《关系假设清单》3 条，标注验证状态' },
