  { theme: '高质量相处时间', tasks: ['每天 15 分钟无手机相处/通话，全程注意力在场', '相处中练习只倾听不给建议，除非对方明确要', '记录：哪类时刻对方的反应和你预期不同'], milestone: '连续 7 天在场式相处，记录 3 个反应偏差' },
  { theme: '倾听脚本训练', tasks: ['练习复述：回应前先说"你的意思是…对吗？"', '本周 3 次对话中有意使用复述，记录对方反应', '把有效的倾听话术写成模板卡'], milestone: '复述话术模板卡 3 张，至少 1 次明显改善对话质量' },
  { theme: '直接询问代替猜测', tasks: ['每周至少 1 次，把心里的猜测换成直接提问', '提问模板："当…发生时，你的感受是？"', '对比：直接问到的答案和你猜的差多少'], milestone: '完成 3 次直接询问，至少 1 次推翻原有猜测' },
  { theme: '半程偏差盘点', tasks: ['汇总日记中的"反应与预期不符"事件', '按主题分类（沟通/时间/金钱/亲密/家人等）', '找出最高频的偏差主题——那就是下一阶段的实验场'], milestone: '《反应偏差分类表》+ 最高频主题' },
  { theme: '冷静期协议', tasks: ['与对方约定：冲突后各自冷静 24 小时再谈（误差持有期）', '冷静期内写"事实—感受—需求"三行笔记', '24 小时后用"我看到…我感到…我需要…"句式重开对话'], milestone: '至少 1 次冲突按协议走完，对比以往升级模式' },
  { theme: '预期预测飞轮', tasks: ['重要对话前写下：我预期对方会怎么反应', '对话后验证，偏差原样记录', '对预测反复失败的场景，换成直接询问'], milestone: '5 次预期预测记录，准确率可见提升' },
  { theme: '小成本试探实验', tasks: ['选 1 个未验证假设，设计一个小成本试探（如换一种表达方式）', '执行并观察反应，不附带解释和期待', '记录结果，判断假设保留/修正/放弃'], milestone: '完成 2 次试探实验，更新《关系假设清单》' },
